{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://stogas.ai/schemas/key-config-v1.json",
	"title": "Stogas API key configuration v1",
	"description": "Structural editor schema for API key configuration. Save-time validation also checks query grammar, IANA time zones, RE2 safety, cross-field limits, and the 16384-byte canonical UTF-8 document limit. Unknown properties are rejected.",
	"type": "object",
	"additionalProperties": false,
	"required": ["version"],
	"properties": {
		"$schema": {
			"const": "https://stogas.ai/schemas/key-config-v1.json"
		},
		"version": {
			"const": 1
		},
		"routing": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"requestPolicy": {
					"enum": ["deny", "filter", "filter_and_sort"],
					"description": "Permission for request-level routing policies. A child cannot increase its parent's permission. Grants and service keys deny request policies unless they explicitly permit them."
				},
				"query": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"description": "A bounded Stogas routing query. See https://stogas.ai/docs/policies/routing."
				},
				"allowedCatalogNodes": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"description": "The lists contain at most 64 IDs in total. A candidate must match each list that is present.",
					"properties": {
						"authors": {
							"$ref": "#/$defs/catalogNodeIds"
						},
						"models": {
							"$ref": "#/$defs/catalogNodeIds"
						},
						"deployments": {
							"$ref": "#/$defs/catalogNodeIds"
						},
						"routes": {
							"$ref": "#/$defs/catalogNodeIds"
						},
						"providers": {
							"$ref": "#/$defs/catalogNodeIds"
						}
					}
				},
				"fallbacks": {
					"type": "object",
					"additionalProperties": false,
					"required": ["maxPreDispatchCandidates"],
					"properties": {
						"maxPreDispatchCandidates": {
							"type": "integer",
							"minimum": 1,
							"maximum": 3,
							"description": "Maximum candidates that Stogas may check before one provider call starts. This does not retry an upstream request."
						}
					}
				}
			}
		},
		"limits": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"requests": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 8,
					"propertyNames": {
						"pattern": "^[a-z][a-z0-9_-]{0,47}$"
					},
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"required": ["max", "window"],
						"properties": {
							"max": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000000000000
							},
							"burst": {
								"type": "integer",
								"minimum": 1,
								"maximum": 120
							},
							"window": {
								"$ref": "#/$defs/requestWindow"
							}
						}
					}
				},
				"spend": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"lifetimeUsd": {
							"$ref": "#/$defs/usd"
						},
						"recurring": {
							"type": "object",
							"minProperties": 1,
							"maxProperties": 8,
							"propertyNames": {
								"pattern": "^[a-z][a-z0-9_-]{0,47}$"
							},
							"additionalProperties": {
								"type": "object",
								"additionalProperties": false,
								"required": ["maxUsd", "timeZone", "window"],
								"properties": {
									"anchor": {
										"$ref": "#/$defs/dateTime"
									},
									"maxUsd": {
										"$ref": "#/$defs/usd"
									},
									"timeZone": {
										"$ref": "#/$defs/timeZone"
									},
									"window": {
										"$ref": "#/$defs/window"
									}
								}
							}
						}
					}
				},
				"tokens": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 8,
					"propertyNames": {
						"pattern": "^[a-z][a-z0-9_-]{0,47}$"
					},
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"max": {
								"type": "integer",
								"minimum": 1,
								"maximum": 1000000000000
							},
							"window": {
								"$ref": "#/$defs/requestWindow"
							}
						},
						"required": ["max", "window"]
					}
				},
				"concurrentRequests": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10000
				}
			}
		},
		"expiresAt": {
			"$ref": "#/$defs/dateTime"
		},
		"access": {
			"type": "object",
			"additionalProperties": false,
			"required": ["deny"],
			"properties": {
				"deny": {
					"type": "array",
					"minItems": 1,
					"maxItems": 16,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["days", "start", "end", "timeZone"],
						"properties": {
							"days": {
								"type": "array",
								"minItems": 1,
								"maxItems": 7,
								"uniqueItems": true,
								"items": {
									"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
								}
							},
							"start": {
								"$ref": "#/$defs/time"
							},
							"end": {
								"$ref": "#/$defs/endTime",
								"description": "The end must be later than the start. Split an overnight period into two entries."
							},
							"timeZone": {
								"$ref": "#/$defs/timeZone"
							}
						}
					}
				}
			}
		},
		"plugins": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"stogasRedaction": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"email_address": {
							"type": "boolean",
							"description": "Email address",
							"x-stogas-group": "Contact"
						},
						"phone_number": {
							"type": "boolean",
							"description": "Formatted phone number, including international",
							"x-stogas-group": "Contact"
						},
						"social_security_number": {
							"type": "boolean",
							"description": "U.S. Social Security number",
							"x-stogas-group": "National and business"
						},
						"credit_card_number": {
							"type": "boolean",
							"description": "Credit card number",
							"x-stogas-group": "Bank"
						},
						"ip_address": {
							"type": "boolean",
							"description": "IPv4 or IPv6 address",
							"x-stogas-group": "Network"
						},
						"api_keys_and_secrets": {
							"type": "boolean",
							"description": "API keys, credentials and secrets",
							"x-stogas-group": "Secrets"
						},
						"bank_identifiers": {
							"type": "boolean",
							"description": "IBAN and U.S. routing numbers",
							"x-stogas-group": "Bank"
						},
						"national_identifiers": {
							"type": "boolean",
							"description": "National, tax and business identifiers",
							"x-stogas-group": "National and business"
						},
						"health_identifiers": {
							"type": "boolean",
							"description": "Healthcare and health-insurance identifiers",
							"x-stogas-group": "Health"
						},
						"customPattern": {
							"type": "string",
							"minLength": 1,
							"maxLength": 512,
							"description": "One RE2 expression, limited to 512 UTF-8 bytes."
						}
					}
				}
			}
		}
	},
	"$defs": {
		"catalogNodeIds": {
			"type": "array",
			"minItems": 0,
			"maxItems": 64,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/catalogNodeId"
			}
		},
		"catalogNodeId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128,
			"pattern": "^[a-z0-9][a-z0-9._:-]*$"
		},
		"dateTime": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?!0000-)"
		},
		"requestWindow": {
			"type": "object",
			"additionalProperties": false,
			"required": ["count", "unit"],
			"properties": {
				"count": {
					"type": "integer",
					"minimum": 1,
					"maximum": 999999
				},
				"unit": {
					"enum": ["second", "minute", "hour", "day", "week"]
				}
			}
		},
		"time": {
			"type": "string",
			"pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
		},
		"endTime": {
			"type": "string",
			"pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
		},
		"timeZone": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[A-Za-z0-9_+\\-/]+$",
			"description": "An IANA time zone name, such as America/New_York or UTC."
		},
		"usd": {
			"type": "string",
			"maxLength": 64,
			"pattern": "^0*(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,18})?|1000000000000(?:\\.0{1,18})?)$",
			"description": "A non-negative decimal amount with at most 18 decimal places."
		},
		"window": {
			"type": "object",
			"additionalProperties": false,
			"required": ["count", "unit"],
			"properties": {
				"count": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1000
				},
				"unit": {
					"enum": ["minute", "hour", "day", "week", "month", "year"]
				}
			}
		}
	}
}
