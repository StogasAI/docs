{
	"name": "stogas-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"test": "playwright test",
		"generate:openapi": "bun scripts/validate-openapi.ts && bun scripts/generate-openapi.ts",
		"build": "bun run generate:openapi && next build",
		"clean": "rm -rf .next .wrangler .source out next-env.d.ts tsconfig.tsbuildinfo",
		"dev": "bun run generate:openapi && next dev",
		"typecheck": "bun run generate:openapi && next typegen && fumadocs-mdx && tsc --noEmit",
		"postinstall": "fumadocs-mdx"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fuma-translate/react": "1.0.2",
		"@fumadocs/json-schema": "0.3.0",
		"class-variance-authority": "0.7.1",
		"fumadocs-core": "16.17.1",
		"fumadocs-mdx": "15.4.7",
		"fumadocs-openapi": "12.4.1",
		"fumadocs-ui": "16.17.1",
		"hast-util-to-jsx-runtime": "2.3.6",
		"lucide-react": "1.55.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shiki": "4.5.0",
		"tailwind-merge": "3.7.0",
		"yaml": "2.9.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.64.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"postcss": "8.5.29",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"wrangler": "4.149.0",
		"@fumadocs/cli": "1.7.5"
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": ">=22.13.0"
	},
	"packageManager": "bun@1.4.2",
	"patchedDependencies": {
		"@fumadocs/json-schema@0.3.0": "patches/fumadocs-json-schema@0.3.0.patch",
		"fumadocs-openapi@12.4.1": "patches/fumadocs-openapi@12.4.1.patch"
	},
	"overrides": {
		"undici": "7.30.0",
		"sharp": "0.35.5"
	}
}
