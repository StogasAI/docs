{
	"name": "stogas-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"test": "playwright test",
		"generate:openapi": "bun scripts/validate-openapi.ts && bun scripts/generate-openapi.ts",
		"build": "bun run generate:openapi && next build && bun scripts/copy-markdown.ts",
		"clean": "rm -rf .next .wrangler .source out next-env.d.ts tsconfig.tsbuildinfo",
		"dev": "bun run generate:openapi && next dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "bun run generate:openapi && next typegen && fumadocs-mdx && tsc --noEmit",
		"postinstall": "fumadocs-mdx"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fuma-translate/react": "1.0.2",
		"@fumadocs/json-schema": "0.3.5",
		"class-variance-authority": "0.7.1",
		"fumadocs-core": "16.19.3",
		"fumadocs-mdx": "15.6.2",
		"fumadocs-openapi": "12.6.4",
		"fumadocs-ui": "16.19.3",
		"lucide-react": "1.73.0",
		"next": "16.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shiki": "4.6.0",
		"tailwind-merge": "3.7.0",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/postcss": "4.3.5",
		"@types/mdx": "2.0.14",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"postcss": "8.5.32",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"wrangler": "4.156.0",
		"@fumadocs/cli": "1.9.2"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22.13.0"
	},
	"packageManager": "bun@1.4.4",
	"patchedDependencies": {
		"@fumadocs/json-schema@0.3.5": "patches/fumadocs-json-schema@0.3.5.patch",
		"fumadocs-openapi@12.6.4": "patches/fumadocs-openapi@12.6.4.patch"
	}
}
