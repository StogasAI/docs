{
	"name": "stogas-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"build:worker": "opennextjs-cloudflare build",
		"cf-typegen": "wrangler types",
		"clean": "rm -rf .next .open-next .wrangler .source next-env.d.ts tsconfig.tsbuildinfo",
		"deploy:production": "bun ../../scripts/stogas.ts deploy production docs",
		"deploy:staging": "bun ../../scripts/stogas.ts deploy staging docs",
		"dev": "bun ../../scripts/stogas.ts dev docs",
		"preview": "bun ../../scripts/stogas.ts preview docs",
		"start": "next start",
		"typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
		"types:check": "bun run typecheck",
		"postinstall": "fumadocs-mdx"
	},
	"dependencies": {
		"@stogas/shared": "workspace:*",
		"fumadocs-core": "16.8.5",
		"fumadocs-mdx": "14.3.2",
		"fumadocs-openapi": "^10.5.2",
		"fumadocs-ui": "16.8.5",
		"lucide-react": "^1.11.0",
		"next": "16.2.4",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"shiki": "^3.18.0",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "^1.19.4",
		"@tailwindcss/postcss": "^4.2.4",
		"@types/mdx": "^2.0.13",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"postcss": "^8.5.10",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"wrangler": "^4.85.0"
	}
}
