{
	"name": "stogas-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"generate:openapi": "bun scripts/validate-openapi.ts && bun scripts/generate-openapi.ts",
		"build": "bun run generate:openapi && next build",
		"clean": "rm -rf .next .wrangler .source out next-env.d.ts tsconfig.tsbuildinfo",
		"dev": "bun run generate:openapi && next dev",
		"typecheck": "bun run generate:openapi && next typegen && fumadocs-mdx && tsc --noEmit",
		"postinstall": "fumadocs-mdx"
	},
	"dependencies": {
		"fumadocs-core": "16.14.3",
		"fumadocs-mdx": "15.2.3",
		"fumadocs-openapi": "11.2.3",
		"fumadocs-ui": "16.14.3",
		"lucide-react": "1.31.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"postcss": "8.5.26",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"wrangler": "4.126.0"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.13.0"
	},
	"packageManager": "bun@1.3.14"
}
