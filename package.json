{
	"name": "stogas-docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"test": "playwright test",
		"generate:openapi": "bun scripts/validate-openapi.ts && bun scripts/generate-openapi.ts",
		"build": "bun run generate:openapi && next build",
		"clean": "rm -rf .next .wrangler .source out next-env.d.ts tsconfig.tsbuildinfo",
		"dev": "bun run generate:openapi && next dev",
		"typecheck": "bun run generate:openapi && next typegen && fumadocs-mdx && tsc --noEmit",
		"postinstall": "fumadocs-mdx"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fuma-translate/react": "1.0.2",
		"fumadocs-core": "16.15.15",
		"fumadocs-mdx": "15.4.5",
		"fumadocs-openapi": "12.0.4",
		"fumadocs-ui": "16.15.15",
		"lucide-react": "1.48.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"yaml": "2.9.1",
		"zod": "4.6.5",
		"@fumadocs/json-schema": "0.2.0",
		"class-variance-authority": "0.7.1",
		"@base-ui/react": "1.8.0",
		"shiki": "4.4.3",
		"hast-util-to-jsx-runtime": "2.3.6"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"postcss": "8.5.26",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"wrangler": "4.126.0",
		"@fumadocs/cli": "1.7.0"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=22.13.0"
	},
	"packageManager": "bun@1.3.14",
	"patchedDependencies": {
		"fumadocs-core@16.15.15": "patches/fumadocs-core@16.15.15.patch",
		"@fumadocs/json-schema@0.2.0": "patches/fumadocs-json-schema@0.2.0.patch",
		"fumadocs-openapi@12.0.4": "patches/fumadocs-openapi@12.0.4.patch"
	}
}
